&GLOBAL
  PROJECT CdSe_zb_GW
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME /scratch/iinfante/cp2k_basis/BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME /scratch/iinfante/cp2k_basis/GTH_SOC_POTENTIALS
    BASIS_SET_FILE_NAME ./RI_BASIS          # Cd RI_29, Se RI_25 from BASIS_RI_MOLOPT
    &MGRID
      CUTOFF 400
      NGRIDS 4
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
    &END QS
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
    &END POISSON
    &KPOINTS
      SCHEME MONKHORST-PACK 4 4 4
      PARALLEL_GROUP_SIZE -1
    &END KPOINTS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-7
      MAX_SCF 150
      ADDED_MOS -1
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.3
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &BANDSTRUCTURE
      &GW
        NUM_TIME_FREQ_POINTS 6
        MEMORY_PER_PROC 18
        EPS_FILTER 1.0E-8
        REGULARIZATION_RI 1.0E-2
        CUTOFF_RADIUS_RI 7.0
        KPOINTS_W 6 6 6
        APPROX_KP_EXTRAPOL .TRUE.
      &END GW
      &SOC
      &END SOC
      &BANDSTRUCTURE_PATH
        NPOINTS 8
        SPECIAL_POINT L     0.5 0.5 0.5
        SPECIAL_POINT GAMMA 0.0 0.0 0.0
        SPECIAL_POINT X     0.5 0.0 0.5
      &END BANDSTRUCTURE_PATH
    &END BANDSTRUCTURE
  &END PROPERTIES
  &SUBSYS
    &CELL
      A -0.00000000 3.07027120 3.07027120
      B 3.07027120 0.00000000 3.07027120
      C 3.07027120 3.07027120 0.00000000
      PERIODIC XYZ
    &END CELL
    &COORD
      Cd 0.00000000 0.00000000 0.00000000
      Se 4.60540680 4.60540680 4.60540680
    &END COORD
    &KIND Cd
      BASIS_SET ORB DZVP-MOLOPT-PBE-GTH-q12
      BASIS_SET RI_AUX RI_29_3_3_2_1_0_0_0_8.1e-03
      POTENTIAL GTH-PBE-q12
    &END KIND
    &KIND Se
      BASIS_SET ORB DZVP-MOLOPT-PBE-GTH-q6
      BASIS_SET RI_AUX RI_25_2_2_2_1_0_0_0_3.3e-03
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
