&GLOBAL
  PROJECT CdS_wz
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME /scratch/iinfante/cp2k_basis/BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME /scratch/iinfante/cp2k_basis/POTENTIAL_UZH
    &MGRID
      CUTOFF 400
      NGRIDS 4
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
    &END QS
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
    &END POISSON
    &KPOINTS
      SCHEME MONKHORST-PACK 8 8 4
      SYMMETRY ON
      EPS_GEO 1.0E-5
      FULL_GRID .TRUE.
    &END KPOINTS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-7
      MAX_SCF 150
      ADDED_MOS 20
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.3
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &PRINT
      &BAND_STRUCTURE
        FILE_NAME CdS_wz.bs
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 44
          SPECIAL_POINT 0.00000000 0.00000000 0.00000000  # \Gamma
          SPECIAL_POINT 0.50000000 -0.00000000 0.00000000  # M
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 26
          SPECIAL_POINT 0.50000000 -0.00000000 0.00000000  # M
          SPECIAL_POINT 0.33333333 0.33333333 0.00000000  # K
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 51
          SPECIAL_POINT 0.33333333 0.33333333 0.00000000  # K
          SPECIAL_POINT 0.00000000 0.00000000 0.00000000  # \Gamma
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 24
          SPECIAL_POINT 0.00000000 0.00000000 0.00000000  # \Gamma
          SPECIAL_POINT 0.00000000 0.00000000 0.50000000  # A
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 44
          SPECIAL_POINT 0.00000000 0.00000000 0.50000000  # A
          SPECIAL_POINT 0.50000000 -0.00000000 0.50000000  # L
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 26
          SPECIAL_POINT 0.50000000 -0.00000000 0.50000000  # L
          SPECIAL_POINT 0.33333333 0.33333333 0.50000000  # H
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 51
          SPECIAL_POINT 0.33333333 0.33333333 0.50000000  # H
          SPECIAL_POINT 0.00000000 0.00000000 0.50000000  # A
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 24
          SPECIAL_POINT 0.50000000 -0.00000000 0.50000000  # L
          SPECIAL_POINT 0.50000000 -0.00000000 0.00000000  # M
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 24
          SPECIAL_POINT 0.33333333 0.33333333 0.00000000  # K
          SPECIAL_POINT 0.33333333 0.33333333 0.50000000  # H
        &END KPOINT_SET
      &END BAND_STRUCTURE
      &KS_CSR_WRITE
        REAL_SPACE .TRUE.
        THRESHOLD 1.0E-14
        UPPER_TRIANGULAR .FALSE.
        BINARY .FALSE.
      &END KS_CSR_WRITE
      &S_CSR_WRITE
        REAL_SPACE .TRUE.
        THRESHOLD 1.0E-14
        UPPER_TRIANGULAR .FALSE.
        BINARY .FALSE.
      &END S_CSR_WRITE
      &TREXIO
        FILENAME CdS_wz_trexio
      &END TREXIO
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      A 2.06850000 -3.58274710 0.00000000
      B 2.06850000 3.58274710 0.00000000
      C 0.00000000 0.00000000 6.71440000
      PERIODIC XYZ
    &END CELL
    &COORD
      Cd 2.06850000 -1.19424903 0.00000000
      Cd 2.06850000 1.19424903 3.35720000
      S 2.06850000 -1.19424903 2.51790000
      S 2.06850000 1.19424903 5.87510000
    &END COORD
    &KIND Cd
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q12
      POTENTIAL GTH-PBE-q12
    &END KIND
    &KIND S
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q6
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
