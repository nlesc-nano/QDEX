&GLOBAL
  PROJECT GaP_zb
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME /scratch/iinfante/cp2k_basis/BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME /scratch/iinfante/cp2k_basis/POTENTIAL_UZH
    &MGRID
      CUTOFF 400
      NGRIDS 4
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
    &END QS
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
    &END POISSON
    &KPOINTS
      SCHEME MONKHORST-PACK 9 9 9
      SYMMETRY ON
      EPS_GEO 1.0E-5
      FULL_GRID .TRUE.
    &END KPOINTS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-7
      MAX_SCF 150
      ADDED_MOS 20
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.3
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &PRINT
      &BAND_STRUCTURE
        FILE_NAME GaP_zb.bs
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 58
          SPECIAL_POINT 0.00000000 0.00000000 0.00000000  # \Gamma
          SPECIAL_POINT 0.50000000 0.00000000 0.50000000  # X
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 29
          SPECIAL_POINT 0.50000000 0.00000000 0.50000000  # X
          SPECIAL_POINT 0.50000000 0.25000000 0.75000000  # W
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 21
          SPECIAL_POINT 0.50000000 0.25000000 0.75000000  # W
          SPECIAL_POINT 0.37500000 0.37500000 0.75000000  # K
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 62
          SPECIAL_POINT 0.37500000 0.37500000 0.75000000  # K
          SPECIAL_POINT 0.00000000 0.00000000 0.00000000  # \Gamma
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 50
          SPECIAL_POINT 0.00000000 0.00000000 0.00000000  # \Gamma
          SPECIAL_POINT 0.50000000 0.50000000 0.50000000  # L
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 36
          SPECIAL_POINT 0.50000000 0.50000000 0.50000000  # L
          SPECIAL_POINT 0.62500000 0.25000000 0.62500000  # U
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 21
          SPECIAL_POINT 0.62500000 0.25000000 0.62500000  # U
          SPECIAL_POINT 0.50000000 0.25000000 0.75000000  # W
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 41
          SPECIAL_POINT 0.50000000 0.25000000 0.75000000  # W
          SPECIAL_POINT 0.50000000 0.50000000 0.50000000  # L
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 36
          SPECIAL_POINT 0.50000000 0.50000000 0.50000000  # L
          SPECIAL_POINT 0.37500000 0.37500000 0.75000000  # K
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 21
          SPECIAL_POINT 0.62500000 0.25000000 0.62500000  # U
          SPECIAL_POINT 0.50000000 0.00000000 0.50000000  # X
        &END KPOINT_SET
      &END BAND_STRUCTURE
      &KS_CSR_WRITE
        REAL_SPACE .TRUE.
        THRESHOLD 1.0E-14
        UPPER_TRIANGULAR .FALSE.
        BINARY .FALSE.
      &END KS_CSR_WRITE
      &S_CSR_WRITE
        REAL_SPACE .TRUE.
        THRESHOLD 1.0E-14
        UPPER_TRIANGULAR .FALSE.
        BINARY .FALSE.
      &END S_CSR_WRITE
      &TREXIO
        FILENAME GaP_zb_trexio
      &END TREXIO
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      A -0.00000000 2.72581250 2.72581250
      B 2.72581250 0.00000000 2.72581250
      C 2.72581250 2.72581250 0.00000000
      PERIODIC XYZ
    &END CELL
    &COORD
      Ga 0.00000000 0.00000000 0.00000000
      P 1.36290625 1.36290625 1.36290625
    &END COORD
    &KIND Ga
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q13
      POTENTIAL GTH-PBE-q13
    &END KIND
    &KIND P
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q5
      POTENTIAL GTH-PBE-q5
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
