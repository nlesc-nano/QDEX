&GLOBAL
  PROJECT CsPbI3_ortho
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME /scratch/usr/becivinf/cp2k_basis/BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME /scratch/usr/becivinf/cp2k_basis/POTENTIAL_UZH
    &MGRID
      CUTOFF 400
      NGRIDS 4
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
    &END QS
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
    &END POISSON
    &KPOINTS
      SCHEME MONKHORST-PACK 3 3 2
      SYMMETRY ON
      EPS_GEO 1.0E-5
      FULL_GRID .TRUE.
    &END KPOINTS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-7
      MAX_SCF 150
      ADDED_MOS 68
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.3
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &PRINT
      &BAND_STRUCTURE
        FILE_NAME CsPbI3_ortho.bs
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 19
          SPECIAL_POINT 0.00000000 0.00000000 0.00000000  # \Gamma
          SPECIAL_POINT 0.50000000 -0.00000000 0.00000000  # X
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 18
          SPECIAL_POINT 0.50000000 -0.00000000 0.00000000  # X
          SPECIAL_POINT 0.50000000 0.50000000 0.00000000  # S
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 19
          SPECIAL_POINT 0.50000000 0.50000000 0.00000000  # S
          SPECIAL_POINT 0.00000000 0.50000000 0.00000000  # Y
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 18
          SPECIAL_POINT 0.00000000 0.50000000 0.00000000  # Y
          SPECIAL_POINT 0.00000000 0.00000000 0.00000000  # \Gamma
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 13
          SPECIAL_POINT 0.00000000 0.00000000 0.00000000  # \Gamma
          SPECIAL_POINT 0.00000000 -0.00000000 0.50000000  # Z
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 19
          SPECIAL_POINT 0.00000000 -0.00000000 0.50000000  # Z
          SPECIAL_POINT 0.50000000 -0.00000000 0.50000000  # U
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 18
          SPECIAL_POINT 0.50000000 -0.00000000 0.50000000  # U
          SPECIAL_POINT 0.50000000 0.50000000 0.50000000  # R
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 19
          SPECIAL_POINT 0.50000000 0.50000000 0.50000000  # R
          SPECIAL_POINT 0.00000000 0.50000000 0.50000000  # T
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 18
          SPECIAL_POINT 0.00000000 0.50000000 0.50000000  # T
          SPECIAL_POINT 0.00000000 0.00000000 0.50000000  # Z
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 13
          SPECIAL_POINT 0.00000000 0.50000000 0.00000000  # Y
          SPECIAL_POINT 0.00000000 0.50000000 0.50000000  # T
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 13
          SPECIAL_POINT 0.50000000 -0.00000000 0.50000000  # U
          SPECIAL_POINT 0.50000000 -0.00000000 0.00000000  # X
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 13
          SPECIAL_POINT 0.50000000 0.50000000 0.00000000  # S
          SPECIAL_POINT 0.50000000 0.50000000 0.50000000  # R
        &END KPOINT_SET
      &END BAND_STRUCTURE
      &KS_CSR_WRITE
        REAL_SPACE .TRUE.
        THRESHOLD 1.0E-14
        UPPER_TRIANGULAR .FALSE.
        BINARY .FALSE.
      &END KS_CSR_WRITE
      &S_CSR_WRITE
        REAL_SPACE .TRUE.
        THRESHOLD 1.0E-14
        UPPER_TRIANGULAR .FALSE.
        BINARY .FALSE.
      &END S_CSR_WRITE
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      A 8.57830000 0.00000000 0.00000000
      B -0.00000000 8.86370000 0.00000000
      C 0.00000000 0.00000000 12.48380000
      PERIODIC XYZ
    &END CELL
    &COORD
      Cs 0.17208070 3.88575744 3.12095000
      Cs 4.46123070 0.54609256 9.36285000
      Cs 4.11706930 8.31760744 3.12095000
      Cs 8.40621930 4.97794256 9.36285000
      Pb 0.00000000 0.00000000 0.00000000
      Pb 4.28915000 4.43185000 0.00000000
      Pb 4.28915000 4.43185000 6.24190000
      Pb 0.00000000 0.00000000 6.24190000
      I 4.84313661 4.45870701 3.12095000
      I 0.55398661 8.83684299 9.36285000
      I 8.02431339 0.02685701 3.12095000
      I 3.73516339 4.40499299 9.36285000
      I 2.61166344 1.76130583 0.40846994
      I 6.90081344 2.67054417 12.07533006
      I 1.67748656 6.19315583 5.83343006
      I 5.96663656 7.10239417 6.65036994
      I 5.96663656 7.10239417 12.07533006
      I 1.67748656 6.19315583 0.40846994
      I 6.90081344 2.67054417 6.65036994
      I 2.61166344 1.76130583 5.83343006
    &END COORD
    &KIND Cs
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q9
      POTENTIAL GTH-PBE-q9
    &END KIND
    &KIND I
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q7
      POTENTIAL GTH-PBE-q7
    &END KIND
    &KIND Pb
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q4
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
