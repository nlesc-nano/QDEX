&GLOBAL
  PROJECT CsPbCl3_ortho
  RUN_TYPE GEO_OPT
  PRINT_LEVEL LOW
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME /scratch/usr/becivinf/cp2k_basis/BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME /scratch/usr/becivinf/cp2k_basis/POTENTIAL_UZH
    &MGRID
      CUTOFF 400
      NGRIDS 4
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
    &END QS
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
    &END POISSON
    &KPOINTS
      SCHEME MONKHORST-PACK 4 4 3
      SYMMETRY ON
      EPS_GEO 1.0E-5
      FULL_GRID .TRUE.
    &END KPOINTS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-7
      MAX_SCF 150
      ADDED_MOS 68
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.3
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A 7.87309401 0.00000000 0.00000000
      B -0.00000000 7.91707778 0.00000000
      C 0.00000000 0.00000000 11.26973550
      PERIODIC XYZ
    &END CELL
    &COORD
      Cs 0.05526912 4.20396830 2.81743387
      Cs 3.99181612 7.67164837 8.45230162
      Cs 7.81782489 3.71310948 8.45230162
      Cs 3.88127789 0.24542941 2.81743387
      Pb 0.00000000 0.00000000 5.63486775
      Pb 3.93654700 3.95853889 5.63486775
      Pb 0.00000000 0.00000000 0.00000000
      Pb 3.93654700 3.95853889 0.00000000
      Cl 1.62240848 2.32342482 5.36563377
      Cl 5.55895549 1.63511407 5.90410173
      Cl 6.25068553 5.59365296 11.00050152
      Cl 2.31413852 6.28196371 0.26923398
      Cl 6.25068553 5.59365296 5.90410173
      Cl 2.31413852 6.28196371 5.36563377
      Cl 1.62240848 2.32342482 0.26923398
      Cl 5.55895549 1.63511407 11.00050152
      Cl 0.35822578 0.02929319 8.45230162
      Cl 4.29477278 3.92924570 2.81743387
      Cl 7.51486823 7.88778459 2.81743388
      Cl 3.57832123 3.98783208 8.45230162
    &END COORD
    &KIND Cl
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q7
      POTENTIAL GTH-PBE-q7
    &END KIND
    &KIND Cs
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q9
      POTENTIAL GTH-PBE-q9
    &END KIND
    &KIND Pb
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q4
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
&MOTION
  &GEO_OPT
    OPTIMIZER BFGS
    MAX_ITER 60
    MAX_FORCE 4.5E-4
  &END GEO_OPT
&END MOTION
