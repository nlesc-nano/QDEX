&GLOBAL
  PROJECT CsPbBr3_ortho
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME /scratch/iinfante/cp2k_basis/BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME /scratch/iinfante/cp2k_basis/POTENTIAL_UZH
    &MGRID
      CUTOFF 400
      NGRIDS 4
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
    &END QS
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
    &END POISSON
    &KPOINTS
      SCHEME MONKHORST-PACK 3 3 2
      SYMMETRY ON
      EPS_GEO 1.0E-5
      FULL_GRID .TRUE.
    &END KPOINTS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-7
      MAX_SCF 150
      ADDED_MOS 68
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.3
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &PRINT
      &BAND_STRUCTURE
        FILE_NAME CsPbBr3_ortho.bs
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 20
          SPECIAL_POINT 0.00000000 0.00000000 0.00000000  # \Gamma
          SPECIAL_POINT 0.50000000 0.00000000 0.00000000  # X
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 20
          SPECIAL_POINT 0.50000000 0.00000000 0.00000000  # X
          SPECIAL_POINT 0.50000000 0.50000000 0.00000000  # S
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 20
          SPECIAL_POINT 0.50000000 0.50000000 0.00000000  # S
          SPECIAL_POINT 0.00000000 0.50000000 0.00000000  # Y
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 20
          SPECIAL_POINT 0.00000000 0.50000000 0.00000000  # Y
          SPECIAL_POINT 0.00000000 0.00000000 0.00000000  # \Gamma
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 14
          SPECIAL_POINT 0.00000000 0.00000000 0.00000000  # \Gamma
          SPECIAL_POINT -0.00000000 0.00000000 0.50000000  # Z
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 20
          SPECIAL_POINT -0.00000000 0.00000000 0.50000000  # Z
          SPECIAL_POINT 0.50000000 0.00000000 0.50000000  # U
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 20
          SPECIAL_POINT 0.50000000 0.00000000 0.50000000  # U
          SPECIAL_POINT 0.50000000 0.50000000 0.50000000  # R
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 20
          SPECIAL_POINT 0.50000000 0.50000000 0.50000000  # R
          SPECIAL_POINT 0.00000000 0.50000000 0.50000000  # T
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 20
          SPECIAL_POINT -0.00000000 0.50000000 0.50000000  # T
          SPECIAL_POINT -0.00000000 0.00000000 0.50000000  # Z
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 14
          SPECIAL_POINT 0.00000000 0.50000000 0.00000000  # Y
          SPECIAL_POINT -0.00000000 0.50000000 0.50000000  # T
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 14
          SPECIAL_POINT 0.50000000 0.00000000 0.50000000  # U
          SPECIAL_POINT 0.50000000 0.00000000 0.00000000  # X
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 14
          SPECIAL_POINT 0.50000000 0.50000000 0.00000000  # S
          SPECIAL_POINT 0.50000000 0.50000000 0.50000000  # R
        &END KPOINT_SET
      &END BAND_STRUCTURE
      &KS_CSR_WRITE
        REAL_SPACE .TRUE.
        THRESHOLD 1.0E-14
        UPPER_TRIANGULAR .FALSE.
        BINARY .FALSE.
      &END KS_CSR_WRITE
      &S_CSR_WRITE
        REAL_SPACE .TRUE.
        THRESHOLD 1.0E-14
        UPPER_TRIANGULAR .FALSE.
        BINARY .FALSE.
      &END S_CSR_WRITE
      &TREXIO
        FILENAME CsPbBr3_ortho_trexio
      &END TREXIO
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      A 8.19820000 0.00000000 0.00000000
      B -0.00000000 8.24400000 0.00000000
      C 0.00000000 0.00000000 11.73510000
      PERIODIC XYZ
    &END CELL
    &COORD
      Cs 0.05755136 4.37756400 2.93377500
      Cs 4.15665136 7.98843600 8.80132500
      Cs 8.14064864 3.86643600 8.80132500
      Cs 4.04154864 0.25556400 2.93377500
      Pb 0.00000000 0.00000000 5.86755000
      Pb 4.09910000 4.12200000 5.86755000
      Pb 0.00000000 0.00000000 0.00000000
      Pb 4.09910000 4.12200000 0.00000000
      Br 1.68940307 2.41936668 5.58719846
      Br 5.78850307 1.70263332 6.14790154
      Br 6.50879693 5.82463332 11.45474846
      Br 2.40969693 6.54136668 0.28035154
      Br 6.50879693 5.82463332 6.14790154
      Br 2.40969693 6.54136668 5.58719846
      Br 1.68940307 2.41936668 0.28035154
      Br 5.78850307 1.70263332 11.45474846
      Br 0.37301810 0.03050280 8.80132500
      Br 4.47211810 4.09149720 2.93377500
      Br 7.82518190 8.21349720 2.93377500
      Br 3.72608190 4.15250280 8.80132500
    &END COORD
    &KIND Br
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q7
      POTENTIAL GTH-PBE-q7
    &END KIND
    &KIND Cs
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q9
      POTENTIAL GTH-PBE-q9
    &END KIND
    &KIND Pb
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q4
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
