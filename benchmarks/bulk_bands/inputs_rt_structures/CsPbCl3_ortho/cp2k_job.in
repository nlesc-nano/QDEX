&GLOBAL
  PROJECT CsPbCl3_ortho
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME /scratch/usr/becivinf/cp2k_basis/BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME /scratch/usr/becivinf/cp2k_basis/POTENTIAL_UZH
    &MGRID
      CUTOFF 400
      NGRIDS 4
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
    &END QS
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
    &END POISSON
    &KPOINTS
      SCHEME MONKHORST-PACK 4 4 3
      SYMMETRY ON
      EPS_GEO 1.0E-5
      FULL_GRID .TRUE.
    &END KPOINTS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-7
      MAX_SCF 150
      ADDED_MOS 68
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.3
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &PRINT
      &BAND_STRUCTURE
        FILE_NAME CsPbCl3_ortho.bs
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 20
          SPECIAL_POINT 0.00000000 0.00000000 0.00000000  # \Gamma
          SPECIAL_POINT 0.50000000 -0.00000000 0.00000000  # X
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 20
          SPECIAL_POINT 0.50000000 -0.00000000 0.00000000  # X
          SPECIAL_POINT 0.50000000 0.50000000 0.00000000  # S
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 20
          SPECIAL_POINT 0.50000000 0.50000000 0.00000000  # S
          SPECIAL_POINT 0.00000000 0.50000000 0.00000000  # Y
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 20
          SPECIAL_POINT 0.00000000 0.50000000 0.00000000  # Y
          SPECIAL_POINT 0.00000000 0.00000000 0.00000000  # \Gamma
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 14
          SPECIAL_POINT 0.00000000 0.00000000 0.00000000  # \Gamma
          SPECIAL_POINT -0.00000000 0.00000000 0.50000000  # Z
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 20
          SPECIAL_POINT -0.00000000 0.00000000 0.50000000  # Z
          SPECIAL_POINT 0.50000000 -0.00000000 0.50000000  # U
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 20
          SPECIAL_POINT 0.50000000 -0.00000000 0.50000000  # U
          SPECIAL_POINT 0.50000000 0.50000000 0.50000000  # R
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 20
          SPECIAL_POINT 0.50000000 0.50000000 0.50000000  # R
          SPECIAL_POINT 0.00000000 0.50000000 0.50000000  # T
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 20
          SPECIAL_POINT -0.00000000 0.50000000 0.50000000  # T
          SPECIAL_POINT -0.00000000 0.00000000 0.50000000  # Z
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 14
          SPECIAL_POINT 0.00000000 0.50000000 0.00000000  # Y
          SPECIAL_POINT -0.00000000 0.50000000 0.50000000  # T
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 14
          SPECIAL_POINT 0.50000000 -0.00000000 0.50000000  # U
          SPECIAL_POINT 0.50000000 -0.00000000 0.00000000  # X
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 14
          SPECIAL_POINT 0.50000000 0.50000000 0.00000000  # S
          SPECIAL_POINT 0.50000000 0.50000000 0.50000000  # R
        &END KPOINT_SET
      &END BAND_STRUCTURE
      &KS_CSR_WRITE
        REAL_SPACE .TRUE.
        THRESHOLD 1.0E-14
        UPPER_TRIANGULAR .FALSE.
        BINARY .FALSE.
      &END KS_CSR_WRITE
      &S_CSR_WRITE
        REAL_SPACE .TRUE.
        THRESHOLD 1.0E-14
        UPPER_TRIANGULAR .FALSE.
        BINARY .FALSE.
      &END S_CSR_WRITE
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      A 7.87309401 0.00000000 0.00000000
      B -0.00000000 7.91707778 0.00000000
      C 0.00000000 0.00000000 11.26973550
      PERIODIC XYZ
    &END CELL
    &COORD
      Cs 0.07728162 4.35409633 2.81744154
      Cs 4.01382868 7.52152038 8.45229396
      Cs 7.79581239 3.56298150 8.45229398
      Cs 3.85926532 0.39555736 2.81744152
      Pb 0.00000001 0.00000000 5.63486775
      Pb 3.93654701 3.95853889 5.63486775
      Pb -0.00000002 -0.00000000 -0.00000001
      Pb 3.93654699 3.95853889 0.00000000
      Cl 1.58191249 2.36290601 5.23313423
      Cl 5.51845951 1.59563294 6.03660125
      Cl 6.29105485 5.55429742 10.86777475
      Cl 2.35450782 6.32131918 0.40196073
      Cl 6.29118150 5.55417175 6.03660131
      Cl 2.35463449 6.32144486 5.23313420
      Cl 1.58203917 2.36278033 0.40196075
      Cl 5.51858618 1.59575862 10.86777477
      Cl 0.54291477 0.05465248 8.45229190
      Cl 4.47946176 3.90388642 2.81744360
      Cl 7.33017927 7.86242527 2.81744357
      Cl 3.39363227 4.01319139 8.45229193
    &END COORD
    &KIND Cl
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q7
      POTENTIAL GTH-PBE-q7
    &END KIND
    &KIND Cs
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q9
      POTENTIAL GTH-PBE-q9
    &END KIND
    &KIND Pb
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q4
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
