&GLOBAL
  PROJECT PbTe_rs
  RUN_TYPE ENERGY
  PRINT_LEVEL LOW
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME /scratch/iinfante/cp2k_basis/BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME /scratch/iinfante/cp2k_basis/POTENTIAL_UZH
    &MGRID
      CUTOFF 400
      NGRIDS 4
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
    &END QS
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
    &END POISSON
    &KPOINTS
      SCHEME MONKHORST-PACK 8 8 8
      SYMMETRY ON
      EPS_GEO 1.0E-5
      FULL_GRID .TRUE.
    &END KPOINTS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-7
      MAX_SCF 150
      ADDED_MOS 20
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.3
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &PRINT
      &BAND_STRUCTURE
        FILE_NAME PbTe_rs.bs
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 49
          SPECIAL_POINT 0.00000000 0.00000000 0.00000000  # \Gamma
          SPECIAL_POINT 0.50000000 -0.00000000 0.50000000  # X
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 25
          SPECIAL_POINT 0.50000000 -0.00000000 0.50000000  # X
          SPECIAL_POINT 0.50000000 0.25000000 0.75000000  # W
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 17
          SPECIAL_POINT 0.50000000 0.25000000 0.75000000  # W
          SPECIAL_POINT 0.37500000 0.37500000 0.75000000  # K
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 51
          SPECIAL_POINT 0.37500000 0.37500000 0.75000000  # K
          SPECIAL_POINT 0.00000000 0.00000000 0.00000000  # \Gamma
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 42
          SPECIAL_POINT 0.00000000 0.00000000 0.00000000  # \Gamma
          SPECIAL_POINT 0.50000000 0.50000000 0.50000000  # L
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 30
          SPECIAL_POINT 0.50000000 0.50000000 0.50000000  # L
          SPECIAL_POINT 0.62500000 0.25000000 0.62500000  # U
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 17
          SPECIAL_POINT 0.62500000 0.25000000 0.62500000  # U
          SPECIAL_POINT 0.50000000 0.25000000 0.75000000  # W
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 34
          SPECIAL_POINT 0.50000000 0.25000000 0.75000000  # W
          SPECIAL_POINT 0.50000000 0.50000000 0.50000000  # L
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 30
          SPECIAL_POINT 0.50000000 0.50000000 0.50000000  # L
          SPECIAL_POINT 0.37500000 0.37500000 0.75000000  # K
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 17
          SPECIAL_POINT 0.62500000 0.25000000 0.62500000  # U
          SPECIAL_POINT 0.50000000 -0.00000000 0.50000000  # X
        &END KPOINT_SET
      &END BAND_STRUCTURE
      &KS_CSR_WRITE
        REAL_SPACE .TRUE.
        THRESHOLD 1.0E-14
        UPPER_TRIANGULAR .FALSE.
        BINARY .FALSE.
      &END KS_CSR_WRITE
      &S_CSR_WRITE
        REAL_SPACE .TRUE.
        THRESHOLD 1.0E-14
        UPPER_TRIANGULAR .FALSE.
        BINARY .FALSE.
      &END S_CSR_WRITE
      &TREXIO
        FILENAME PbTe_rs_trexio
      &END TREXIO
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      A -0.00000000 3.29212493 3.29212493
      B 3.29212493 0.00000000 3.29212493
      C 3.29212493 3.29212493 0.00000000
      PERIODIC XYZ
    &END CELL
    &COORD
      Te 0.00000000 0.00000000 0.00000000
      Pb 3.29212493 3.29212493 3.29212493
    &END COORD
    &KIND Pb
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q4
      POTENTIAL GTH-PBE-q4
    &END KIND
    &KIND Te
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q6
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
