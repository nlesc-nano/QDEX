&GLOBAL
  PROJECT CdSe_zb_pbe0
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME /scratch/usr/becivinf/cp2k_basis/BASIS_MOLOPT_UZH
    BASIS_SET_FILE_NAME /scratch/usr/becivinf/cp2k_basis/BASIS_ADMM_UZH
    AUTO_BASIS RI_HFX MEDIUM
    SORT_BASIS EXP
    WFN_RESTART_FILE_NAME CdSe_zb_pbe-RESTART.kp
    POTENTIAL_FILE_NAME /scratch/usr/becivinf/cp2k_basis/POTENTIAL_UZH
    &MGRID
      CUTOFF 400
      NGRIDS 4
    &END MGRID
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-5
    &END QS
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
    &END POISSON
    &KPOINTS
      SCHEME MONKHORST-PACK 8 8 8
      SYMMETRY ON
      EPS_GEO 1.0E-5
      FULL_GRID .TRUE.
    &END KPOINTS
    &SCF
      SCF_GUESS RESTART
      EPS_SCF 1.0E-7
      MAX_SCF 150
      ADDED_MOS 20
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.3
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &PBE
          SCALE_X 0.75
          SCALE_C 1.0
        &END PBE
      &END XC_FUNCTIONAL
      &HF
        FRACTION 0.25
        &INTERACTION_POTENTIAL
          POTENTIAL_TYPE TRUNCATED
          CUTOFF_RADIUS 8.0
        &END INTERACTION_POTENTIAL
        &RI
          KP_NGROUPS 16
          EPS_PGF_ORB 1.0E-5
          &PRINT
            KP_RI_MEMORY_ESTIMATE
            KP_RI_PROGRESS_BAR
          &END PRINT
        &END RI
      &END HF
    &END XC
    &AUXILIARY_DENSITY_MATRIX_METHOD
      ADMM_TYPE ADMM2
    &END AUXILIARY_DENSITY_MATRIX_METHOD
    &PRINT
      &BAND_STRUCTURE
        FILE_NAME CdSe_zb_pbe0.bs
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 52
          SPECIAL_POINT 0.00000000 0.00000000 0.00000000  # \Gamma
          SPECIAL_POINT 0.50000000 0.00000000 0.50000000  # X
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 26
          SPECIAL_POINT 0.50000000 0.00000000 0.50000000  # X
          SPECIAL_POINT 0.50000000 0.25000000 0.75000000  # W
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 19
          SPECIAL_POINT 0.50000000 0.25000000 0.75000000  # W
          SPECIAL_POINT 0.37500000 0.37500000 0.75000000  # K
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 55
          SPECIAL_POINT 0.37500000 0.37500000 0.75000000  # K
          SPECIAL_POINT 0.00000000 0.00000000 0.00000000  # \Gamma
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 45
          SPECIAL_POINT 0.00000000 0.00000000 0.00000000  # \Gamma
          SPECIAL_POINT 0.50000000 0.50000000 0.50000000  # L
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 32
          SPECIAL_POINT 0.50000000 0.50000000 0.50000000  # L
          SPECIAL_POINT 0.62500000 0.25000000 0.62500000  # U
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 19
          SPECIAL_POINT 0.62500000 0.25000000 0.62500000  # U
          SPECIAL_POINT 0.50000000 0.25000000 0.75000000  # W
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 37
          SPECIAL_POINT 0.50000000 0.25000000 0.75000000  # W
          SPECIAL_POINT 0.50000000 0.50000000 0.50000000  # L
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 32
          SPECIAL_POINT 0.50000000 0.50000000 0.50000000  # L
          SPECIAL_POINT 0.37500000 0.37500000 0.75000000  # K
        &END KPOINT_SET
        &KPOINT_SET
          UNITS B_VECTOR
          NPOINTS 19
          SPECIAL_POINT 0.62500000 0.25000000 0.62500000  # U
          SPECIAL_POINT 0.50000000 0.00000000 0.50000000  # X
        &END KPOINT_SET
      &END BAND_STRUCTURE
      &KS_CSR_WRITE
        REAL_SPACE .TRUE.
        THRESHOLD 1.0E-14
        UPPER_TRIANGULAR .FALSE.
        BINARY .FALSE.
      &END KS_CSR_WRITE
      &S_CSR_WRITE
        REAL_SPACE .TRUE.
        THRESHOLD 1.0E-14
        UPPER_TRIANGULAR .FALSE.
        BINARY .FALSE.
      &END S_CSR_WRITE
      &TREXIO
        FILENAME CdSe_zb_trexio
      &END TREXIO
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      A -0.00000000 3.02500000 3.02500000
      B 3.02500000 0.00000000 3.02500000
      C 3.02500000 3.02500000 0.00000000
      PERIODIC XYZ
    &END CELL
    &COORD
      Cd 0.00000000 0.00000000 0.00000000
      Se 4.53750000 4.53750000 4.53750000
    &END COORD
    &KIND Cd
      BASIS_SET ORB DZVP-MOLOPT-PBE-GTH-q12
      BASIS_SET AUX_FIT admm-dzp-q12
      POTENTIAL GTH-PBE-q12
    &END KIND
    &KIND Se
      BASIS_SET ORB DZVP-MOLOPT-PBE-GTH-q6
      BASIS_SET AUX_FIT admm-dzp-q6
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
